# Host settings for every role. See docs/operations.md#configuration.
# Every setting is validated at startup; a failure lists each bad field and never its value.

# Postgres, reached over verified TLS.
DATABASE_URL=postgres://tdas:REPLACE@db.internal.example:5432/tdas?sslmode=verify-full
# PEM CA bundle for Postgres, when its certificate is not from a public CA.
# DATABASE_CA_CERT=

# Sealing keys as JSON: the current key ID and every key still needed to open old values.
# Each key is 32 random bytes in base64, for example from: openssl rand -base64 32
SEALING_KEYS={"current":"k1","keys":{"k1":"REPLACE_WITH_32_BYTES_BASE64"}}

# The service's own HTTPS origin; it must match the bootstrap file when both are set.
PUBLIC_ORIGIN=https://service.example

# Path to the bootstrap file. It holds no secrets.
BOOTSTRAP=./bootstrap.json

# Redis for live events. Leave unset to turn events off.
# REDIS_URL=rediss://cache.internal.example:6379

# Optional locally bundled operator console on the API origin. Off by default.
# CONSOLE_ENABLED=false

# Listening ports for the API role and the worker's health routes.
# PORT=3000
# WORKER_HEALTH_PORT=3001

# Limits. Defaults: sign-in 7 days, Job input and result 100 MiB, runtime 1 day,
# results kept 7 days, records kept 30 days, 4 Jobs at a time per worker.
# SIGN_IN_LIMIT=604800
# JOB_INPUT_CAP=104857600
# JOB_RESULT_CAP=104857600
# JOB_RUNTIME_CAP=86400
# JOB_RESULT_RETENTION=604800
# JOB_RECORD_RETENTION=2592000
# WORKER_CONCURRENCY=4

# Upstream timeouts in milliseconds: connecting, waiting for response headers,
# and a stream in either direction that makes no progress.
# UPSTREAM_CONNECT_TIMEOUT=10000
# UPSTREAM_HEADERS_TIMEOUT=120000
# UPSTREAM_IDLE_TIMEOUT=120000
