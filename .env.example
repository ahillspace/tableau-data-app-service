NODE_ENV=production
DATABASE_URL=postgresql://service:replace@127.0.0.1:5432/integrations
SERVICE_ORIGIN=https://integrations.example.com
HOST=127.0.0.1
PORT=3000
DB_POOL_MAX=5
DB_CONTROL_POOL_MAX=2
DB_ACQUIRE_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000
SESSION_MAX_AGE_SECONDS=604800
ACCESS_TOKEN_AGE_SECONDS=900
ENCRYPTION_ACTIVE_KEY_ID=replace
# Supply protected random 32-byte keys as hex. No example key is a usable secret.
ENCRYPTION_KEYS={"replace":"REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"}
