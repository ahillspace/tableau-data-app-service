{
  "id": "google-service-account",
  "name": "Google service account",
  "description": "Service-account JSON import, RFC 7523 exchange and global or regional Vertex AI hosts.",
  "definition": {
    "ownership": "shared",
    "scopes": ["https://www.googleapis.com/auth/cloud-platform"],
    "audience": [],
    "enabled": true,
    "privateHosts": false,
    "credentialPlacement": {
      "kind": "bearer"
    },
    "displayName": "Google service account",
    "apiHosts": ["https://aiplatform.googleapis.com", "https://*-aiplatform.googleapis.com"],
    "authentication": {
      "method": "jwt_bearer",
      "tokenEndpoint": "https://oauth2.googleapis.com/token",
      "clientAuthentication": {
        "method": "none"
      },
      "jwt": {
        "algorithm": "RS256",
        "issuer": {
          "credential": "issuer"
        },
        "audience": "https://oauth2.googleapis.com/token",
        "scope": {
          "source": "scopes",
          "separator": " "
        },
        "keyId": {
          "credential": "keyId"
        },
        "ttlSeconds": 3600
      },
      "response": {
        "format": "json",
        "rules": {
          "successStatuses": [200],
          "rejectedGrant": [
            {
              "path": ["error"],
              "equals": "invalid_grant"
            }
          ]
        },
        "mapping": {
          "accessToken": ["access_token"],
          "refreshToken": ["refresh_token"],
          "expiresIn": ["expires_in"],
          "scope": ["scope"],
          "scopeSeparator": " "
        }
      }
    },
    "credentialImport": {
      "format": "json",
      "fields": {
        "privateKey": ["private_key"],
        "issuer": ["client_email"],
        "keyId": ["private_key_id"]
      },
      "tokenEndpoint": ["token_uri"]
    }
  }
}
