{
  "name": "tableau-data-app-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "bin": {
    "tdas": "dist/cli/tdas.js",
    "tdas-admin": "dist/admin/bin.js"
  },
  "scripts": {
    "build": "node scripts/clean-build.ts && tsc -p tsconfig.build.json && node scripts/build-sdk.ts && node scripts/build-console.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts/*.ts examples/slack",
    "format": "biome check --write src test scripts/*.ts examples/slack",
    "test": "node --test --test-global-setup=test/support/global.ts --test-concurrency=1 'test/**/*.test.ts'",
    "example": "node examples/slack/dev.ts",
    "examples:slack": "node scripts/build-slack-definitions.ts && biome format --write examples/slack/definitions",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "canonicalize": "5.1.0",
    "fastify": "5.12.8",
    "ipaddr.js": "2.5.0",
    "kysely": "0.29.9",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
