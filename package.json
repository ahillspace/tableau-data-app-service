{
  "name": "tableau-data-app-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "node dist/api.js",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "oauth4webapi": "^3.8.8",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@embedded-postgres/linux-x64": "^18.6.0-beta.19",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "node": "^26.13.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "node@26.13.1": true,
    "esbuild@0.28.2": true
  }
}
