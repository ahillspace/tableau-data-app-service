   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 1,
   "text": "Presets implement the ProviderType interface in Connections;\nRouter, Jobs and Events read capabilities, handlers and event sources from it.",
   "originalText": "Presets implement the ProviderType interface in Connections;\nRouter, Jobs and Events read capabilities, handlers and event sources from it.",
