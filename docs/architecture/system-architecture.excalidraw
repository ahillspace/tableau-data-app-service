  {
   "id": "trust-note",
   "type": "text",
   "x": 40,
   "y": 1290,
   "width": 247.5,
   "height": 243.75,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1527703408,
   "version": 1,
   "versionNonce": 956887592,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 15,
   "fontFamily": 1,
   "text": "Trust boundaries\n\nThe calling app's origin and site\nare never trusted; only the\nbearer or restore cookie is.\n\nEvery provider secret is sealed\nat rest; the host holds no\nprovider secret in plain text.\n\nEvery redirect is bound by\nPKCE and state; callbacks and\nevents by per-source checks.",
   "originalText": "Trust boundaries\n\nThe calling app's origin and site\nare never trusted; only the\nbearer or restore cookie is.\n\nEvery provider secret is sealed\nat rest; the host holds no\nprovider secret in plain text.\n\nEvery redirect is bound by\nPKCE and state; callbacks and\nevents by per-source checks.",
   "lineHeight": 1.25,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "baseline": 239
  }
 ],
